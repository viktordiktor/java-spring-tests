<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="JavaTestingAutomation" verbose="1" parallel="none">

    <test name="API tests">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <packages>
            <package name="com.nikanenka.java.testing.auto.api.tests.*"/>
        </packages>
    </test>

    <test name="UI tests">
        <groups>
            <run>
                <include name="ui"/>
            </run>
        </groups>
        <packages>
            <package name="com.nikanenka.java.testing.auto.ui.tests.*"/>
        </packages>
    </test>

</suite>
